PORT=8080
HIFZLINK_ADMIN_USER=
HIFZLINK_ADMIN_PASS=
HIFZLINK_UMAMI_ID=

# Google Sign-In (OAuth 2.0 Web client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the callback URL registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

# Quran Foundation Content API (audio only; not used for user sign-in)
# Pre-production: https://prelive-oauth2.quran.foundation
# Production:     https://oauth2.quran.foundation
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_AUTH_ENDPOINT=https://prelive-oauth2.quran.foundation
# Pre-production: https://apis-prelive.quran.foundation
# Production:     https://apis.quran.foundation
QF_API_BASE=https://apis-prelive.quran.foundation
